# ──────────────────────────────────────────────
# TALOS Report API — Variables de entorno
# Copia este archivo a .env y ajusta los valores
# ──────────────────────────────────────────────

# ── Base de datos ──────────────────────────────
# MySQL (local / desarrollo)
DATABASE_URL=mysql+aiomysql://root:1234@localhost:3306/talos_tecmty

# Oracle Autonomous DB (descomentar al migrar)
# DATABASE_URL=oracle+oracledb://usuario:password@host:1521/?service_name=nombre_servicio

# ── API ────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=cambia-esto-en-produccion

# ── Scheduler ──────────────────────────────────
# Día y hora del reporte automático semanal (cron)
SCHEDULER_DAY_OF_WEEK=sun    # mon, tue, wed, thu, fri, sat, sun
SCHEDULER_HOUR=23
SCHEDULER_MINUTE=0
SCHEDULER_TIMEZONE=America/Mexico_City

# ── Almacenamiento de PDFs ─────────────────────
STORAGE_BACKEND=local        # local | oci
STORAGE_LOCAL_PATH=./storage/reports

# OCI Object Storage (descomentar al migrar)
# OCI_NAMESPACE=tu-namespace
# OCI_BUCKET=talos-reports
# OCI_REGION=us-ashburn-1
# OCI_CONFIG_FILE=~/.oci/config

# ── Notificaciones ─────────────────────────────
# NOTIFICATIONS_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-correo@dominio.com
# SMTP_PASSWORD=tu-app-password
# EMAIL_FROM=reportes@talos.com
